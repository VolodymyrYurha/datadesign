# Copy to .env and adjust. docker compose reads .env from this folder.
NEO4J_PASSWORD=usi-study-pass
STACK_VERSION=9.4.5
# Heap caps keep the whole stack around 4 GB of RAM.
ES_JAVA_OPTS=-Xms1g -Xmx1g
NEO4J_HEAP=1G
# Admin login (POST /api/auth/login) for /api/admin/** write endpoints.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Signs login tokens; empty = random per API start (you log in again after a restart).
ADMIN_TOKEN_SECRET=
# Optional static key for scripts, sent as X-Admin-Key. Empty = off.
ADMIN_API_KEY=
