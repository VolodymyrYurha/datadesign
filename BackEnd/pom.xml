<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent build, the Java equivalent of a .sln.
  Each <module> below is like a .csproj. Dependencies point inward:

    api ──> application ──> domain
     │                        ^
     └────> dal ──────────────┘
             └──> infrastructure
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <groupId>ch.usi.studysystem</groupId>
    <artifactId>study-system</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>USI Study System</name>

    <modules>
        <module>domain</module>
        <module>infrastructure</module>
        <module>application</module>
        <module>dal</module>
        <module>api</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>3.2.1</springdoc.version>
    </properties>

    <!-- Versions of our own modules, so child poms can reference them without a version. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.usi.studysystem</groupId>
                <artifactId>domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.usi.studysystem</groupId>
                <artifactId>infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.usi.studysystem</groupId>
                <artifactId>application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.usi.studysystem</groupId>
                <artifactId>dal</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
